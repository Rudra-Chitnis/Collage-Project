# Backend only. Never expose Gemini credentials through Vite variables.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_publishable_or_anon_key
FRONTEND_ORIGIN=http://localhost:5173

# Frontend public Supabase settings (protected by authenticated RLS policies).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
VITE_API_URL=http://127.0.0.1:8005
